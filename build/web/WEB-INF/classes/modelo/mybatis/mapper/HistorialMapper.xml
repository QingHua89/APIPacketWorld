<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//ES"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="historial">
    <select id="historial-completo" resultType="pojo.HistorialCambios">
        select guia,idEstadoEnvio,idColaborador,motivo,fechaHoraCambio
        from cambiosHistoricos
    </select>
    
    <insert id="registrar" parameterType="pojo.HistorialCambios">
        insert into cambiosHistoricos (guia,idEstadoEnvio,idColaborador,motivo,fechaHoraCambio)
        values (#{guia},#{idEstadoEnvio},#{idColaborador},#{motivo},#{fechaHoraCambio})
    </insert>
    
    <!--<update id="actualizar-envio" parameterType="pojo.HistorialCambios">
        update cambiosHistoricos
        set idEstadoEnvio=#{idEstadoEnvio},idColaborador=#{idColaborador},
        motivo=#{motivo},fechaHoraCambio=#{fechaHoraCambio}
    </update>-->
</mapper>