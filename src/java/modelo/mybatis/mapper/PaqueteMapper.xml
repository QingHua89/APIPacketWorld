<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//ES"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="paquete">
    <select id="paquetes" resultType="pojo.Paquete">
        select idPaquete, idEnvio, descricion, peso, alto, ancho, profundidad
        from paquete
    </select>
    
    <insert id="nuevo" parameterType="pojo.Paquete">
        insert into paquete (idEnvio, descripcion, peso, alto, ancho, profundidad)
        values (#{idEnvio}, #{descripcion}, #{peso}, #{alto}, #{ancho}, #{profundidad})
    </insert>
    
    <update id="editar" parameterType="pojo.Paquete">
        update paquete
        set descripcion=#{idEnvio},peso=#{descripcion},
        alto=#{peso},ancho=#{ancho},profundidad=#{profundidad}
        where idPaquete=#{idPaquete}
    </update>
    
    <delete id="eliminar-siempre" parameterType="int">
        delete from paquete whete idPaquete=#{idPaquete}
    </delete>
    
    <update id="eliminar-envio" parameterType="pojo.Paquete">
        update paquete
        set idEnvio=#{idEnvio}
        where idPaquete=#{idPaquete}
    </update>
    
    <!--<select>
        select idPaquete, idEnvio, descricion, peso, alto, ancho, profundidad,
        e.guia        
        from paquete
        inner join envio e
        where guia=#{guia}
    </select>-->
    
</mapper>